{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Arithmetic Program (Add, Sub, Mul, Div)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal"
        },
        {
            "name": "FastAPI: Uvicorn Server",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--reload",
                "--port",
                "8000"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Pytest: Run Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-p",
                "no:dash",
                "-v",
                "tests/"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Evidently: Run Monitor",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/evidently_monitor.py",
            "console": "integratedTerminal"
        },
        {
            "name": "MLflow: Run Tracking",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train_and_track_mlflow.py",
            "console": "integratedTerminal"
        }
    ]
}
